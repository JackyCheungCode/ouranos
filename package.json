{
  "name": "ouranos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint src tests vite.config.ts vitest.config.ts playwright.config.ts eslint.config.js",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.config.ts\" eslint.config.js",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.config.ts\" eslint.config.js",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/deploy-check",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@porsche-design-system/components-react": "4.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@porsche-design-system/components-js": "4.10.1",
    "@cloudflare/puppeteer": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "4.1.12",
    "wrangler": "4.168.0"
  }
}
