{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ouranos",
  "main": "src/index.js",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
