{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ouranos",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "r2_buckets": [\n    { "binding": "MODELS_BUCKET", "bucket_name": "ouranos-media" }\n  ],\n  "account_id": "ea4e98dce9c478d7dd5c07f10e5c722d"
}
